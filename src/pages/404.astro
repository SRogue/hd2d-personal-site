---
import Base from '../layouts/Base.astro';
import Bgm from '../components/Bgm.astro';
---

<Base title="404 · Alex's Journey" description="Page not found">
  <Bgm />
  <main class="error-page">
    <div class="error-code">404</div>
    <div class="dialogue-box error-box">
      <span class="dialogue-name" data-i18n="error.404.title">Lost?</span>
      <p data-i18n="error.404.text">You've wandered into unmapped lands... The path ahead fades into mist. Turn back, traveler.</p>
      <a href={`${import.meta.env.BASE_URL}/`} class="contact-btn error-back" data-i18n="error.404.back">◄ Return to Start</a>
    </div>
  </main>
</Base>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 30px;
    padding: 24px;
    background: linear-gradient(180deg, #0a0e2c 0%, #1a1f4d 50%, #2d3270 100%);
  }
  .error-code {
    font-family: var(--pixel);
    font-size: 80px;
    color: var(--gold);
    text-shadow: 0 0 30px rgba(255, 215, 112, 0.5), 4px 4px 0 #2a1810;
    letter-spacing: 8px;
    animation: errorGlow 2s ease-in-out infinite;
  }
  @keyframes errorGlow {
    0%, 100% { text-shadow: 0 0 30px rgba(255, 215, 112, 0.5), 4px 4px 0 #2a1810; }
    50% { text-shadow: 0 0 50px rgba(255, 215, 112, 0.8), 4px 4px 0 #2a1810; }
  }
  .error-box {
    text-align: center;
    max-width: 520px;
  }
  .error-box p {
    margin-bottom: 24px;
  }
  .error-back {
    display: inline-block;
  }
  @media (max-width: 720px) {
    .error-code { font-size: 56px; }
  }
</style>
