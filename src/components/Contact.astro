---
const { email = 'mailto:hello@example.com', github = 'https://github.com', twitter = 'https://twitter.com' } = Astro.props;
---

<section class="section contact" id="contact">
  <div class="dialogue-box">
    <div class="dialogue-name" data-i18n="contact.title">Send a Message</div>
    <p data-i18n="contact.text">Find me at the tavern, or send a raven:</p>
    <div class="contact-links">
      <a href={email}   class="contact-btn" data-i18n="contact.email">✉ Email</a>
      <a href={github}  class="contact-btn" data-i18n="contact.github">⚙ GitHub</a>
      <a href={twitter} class="contact-btn" data-i18n="contact.twitter">𝕏 Twitter</a>
    </div>
    <p class="footer-text" data-i18n="contact.footer">— End of Chapter I —</p>
  </div>
</section>
