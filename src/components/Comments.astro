---
// Giscus 评论组件
// 配置说明：前往 https://giscus.app 获取你的 repo-id 和 category-id
// 替换下方 data-repo-id 和 data-category-id 的占位值
// 需要在 GitHub 仓库 Settings → Features → Discussions 中开启 Discussions
---

<section class="comments-section">
  <h2 class="comments-title" data-i18n="comments.title">— Comments —</h2>
  <div class="giscus-container">
    <script is:inline src="https://giscus.app/client.js"
      data-repo="SRogue/hd2d-personal-site"
      data-repo-id="R_kgDPLACEHOLDER"
      data-category="Announcements"
      data-category-id="DIC_kwDPLACEHOLDER"
      data-mapping="pathname"
      data-strict="1"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="dark_dimmed"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async>
    </script>
    <noscript>
      <p class="comments-noscript">Enable JavaScript to view comments.</p>
    </noscript>
  </div>
</section>
