---
import '../styles/hero.css';
const { title = "Alex's Journey", subtitle = "— Chapter I: The Coder of the Starry Night —" } = Astro.props;
---

<section class="hero" id="home">
  <div class="layer layer-sky">
    <div class="moon"></div>
    <div class="stars"></div>
  </div>

  <div class="layer layer-mid">
    <div class="mountain m1"></div>
    <div class="mountain m2"></div>
    <div class="mountain m3"></div>
  </div>

  <div class="layer layer-front">
    <div class="ground"></div>
    <div class="house"></div>
    <div class="tree tree-l"></div>
    <div class="tree tree-r"></div>
    <div class="lantern lantern-l"></div>
    <div class="lantern lantern-r"></div>
    <div class="character-walker">
      <div class="character"></div>
    </div>
  </div>

  <canvas id="fireflies"></canvas>
  <canvas id="weather"></canvas>
  <div class="god-rays"></div>
  <div class="mist-layer"></div>

  <div class="hero-title">
    <h1 data-i18n="hero.title">{title}</h1>
    <p class="subtitle" data-i18n="hero.subtitle">{subtitle}</p>
  </div>

  <nav class="rpg-menu">
    <ul>
      <li><a href="#about" data-i18n="nav.about">About</a></li>
      <li><a href="#blog" data-i18n="nav.blog">Blog</a></li>
      <li><a href="#projects" data-i18n="nav.projects">Projects</a></li>
      <li><a href="#contact" data-i18n="nav.contact">Contact</a></li>
    </ul>
  </nav>

  <div class="scroll-hint" data-i18n="hero.scrollHint">▼ Press to continue ▼</div>
</section>

<script>
  // ===== 萤火虫 + 星尘 + 雾气粒子 =====
  (() => {
    const canvas = document.getElementById('fireflies') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let w = 0, h = 0;
    type Particle = { x:number; y:number; r:number; vx:number; vy:number; phase:number; speed:number; type:'firefly'|'stardust'|'mist' };
    let particles: Particle[] = [];

    const isMobile = window.matchMedia('(max-width: 720px)').matches;
    const FLY_COUNT = isMobile ? 18 : 35;
    const DUST_COUNT = isMobile ? 10 : 20;
    const MIST_COUNT = isMobile ? 3 : 5;

    function resize() {
      const hero = canvas!.parentElement!;
      w = canvas!.width = hero.clientWidth;
      h = canvas!.height = hero.clientHeight;
    }
    function spawn() {
      particles = [];
      for (let i = 0; i < FLY_COUNT; i++) {
        particles.push({ x: Math.random()*w, y: Math.random()*h*0.85, r: 1.2+Math.random()*1.8, vx: (Math.random()-0.5)*0.3, vy: (Math.random()-0.5)*0.3, phase: Math.random()*Math.PI*2, speed: 0.015+Math.random()*0.025, type: 'firefly' });
      }
      for (let i = 0; i < DUST_COUNT; i++) {
        particles.push({ x: Math.random()*w, y: Math.random()*h*0.5, r: 0.5+Math.random()*0.8, vx: (Math.random()-0.5)*0.05, vy: 0.02+Math.random()*0.03, phase: Math.random()*Math.PI*2, speed: 0.03+Math.random()*0.02, type: 'stardust' });
      }
      for (let i = 0; i < MIST_COUNT; i++) {
        particles.push({ x: Math.random()*w, y: h*0.6+Math.random()*h*0.3, r: 60+Math.random()*80, vx: (Math.random()-0.5)*0.15, vy: 0, phase: Math.random()*Math.PI*2, speed: 0.005+Math.random()*0.005, type: 'mist' });
      }
    }
    function frame(t: number) {
      ctx!.clearRect(0, 0, w, h);
      for (const p of particles) {
        p.x += p.vx + Math.sin(t*0.0008+p.phase) * (p.type === 'mist' ? 0.1 : 0.4);
        p.y += p.vy + Math.cos(t*0.001+p.phase) * (p.type === 'mist' ? 0.05 : 0.3);
        if (p.x < -20) p.x = w+20; if (p.x > w+20) p.x = -20;
        if (p.y < -20) p.y = h+20; if (p.y > h+20) p.y = -20;

        if (p.type === 'firefly') {
          const a = Math.max(0, 0.4+Math.sin(t*p.speed+p.phase)*0.5);
          const grad = ctx!.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r*8);
          grad.addColorStop(0, `rgba(255,235,150,${a*0.9})`);
          grad.addColorStop(0.4, `rgba(255,215,112,${a*0.4})`);
          grad.addColorStop(1, 'rgba(255,215,112,0)');
          ctx!.fillStyle = grad; ctx!.beginPath(); ctx!.arc(p.x, p.y, p.r*8, 0, Math.PI*2); ctx!.fill();
          ctx!.fillStyle = `rgba(255,250,200,${a})`; ctx!.beginPath(); ctx!.arc(p.x, p.y, p.r, 0, Math.PI*2); ctx!.fill();
        } else if (p.type === 'stardust') {
          const a = Math.max(0, 0.3+Math.sin(t*p.speed+p.phase)*0.4);
          ctx!.fillStyle = `rgba(200,220,255,${a*0.6})`; ctx!.beginPath(); ctx!.arc(p.x, p.y, p.r, 0, Math.PI*2); ctx!.fill();
        } else {
          const a = 0.03+Math.sin(t*p.speed+p.phase)*0.02;
          const grad = ctx!.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r);
          grad.addColorStop(0, `rgba(180,190,220,${Math.max(0,a)})`);
          grad.addColorStop(1, 'rgba(180,190,220,0)');
          ctx!.fillStyle = grad; ctx!.beginPath(); ctx!.arc(p.x, p.y, p.r, 0, Math.PI*2); ctx!.fill();
        }
      }
      requestAnimationFrame(frame);
    }
    resize(); spawn(); requestAnimationFrame(frame);
    window.addEventListener('resize', () => { resize(); spawn(); });
  })();

  // ===== 天气系统（雨/雪/晴朗）=====
  (() => {
    const canvas = document.getElementById('weather') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let w = 0, h = 0;
    type Drop = { x:number; y:number; len:number; vy:number; vx:number };
    let drops: Drop[] = [];

    const month = new Date().getMonth() + 1;
    let weather: 'clear'|'rain'|'snow' = 'clear';
    if (month === 12 || month <= 2) weather = 'snow';
    else if (month >= 6 && month <= 8) weather = 'rain';
    if (Math.random() < 0.3) {
      const types: ('clear'|'rain'|'snow')[] = ['clear','rain','snow'];
      weather = types[Math.floor(Math.random()*types.length)];
    }

    const isMobile = window.matchMedia('(max-width: 720px)').matches;
    const COUNT = weather === 'rain' ? (isMobile?60:120) : (isMobile?30:60);

    function resize() { const hero = canvas!.parentElement!; w = canvas!.width = hero.clientWidth; h = canvas!.height = hero.clientHeight; }
    function spawn() {
      drops = [];
      if (weather === 'clear') return;
      for (let i = 0; i < COUNT; i++) {
        drops.push({ x: Math.random()*w, y: Math.random()*h, len: weather==='rain'?10+Math.random()*15:2+Math.random()*3, vy: weather==='rain'?8+Math.random()*6:1+Math.random()*2, vx: weather==='rain'?-1.5:(Math.random()-0.5)*0.5 });
      }
    }
    function frame() {
      ctx!.clearRect(0, 0, w, h);
      if (weather !== 'clear') {
        for (const d of drops) {
          d.x += d.vx; d.y += d.vy;
          if (d.y > h) { d.y = -10; d.x = Math.random()*w; }
          if (d.x < -10) d.x = w+10; if (d.x > w+10) d.x = -10;
          if (weather === 'rain') {
            ctx!.strokeStyle = 'rgba(150,180,220,0.4)'; ctx!.lineWidth = 1;
            ctx!.beginPath(); ctx!.moveTo(d.x, d.y); ctx!.lineTo(d.x+d.vx*2, d.y+d.len); ctx!.stroke();
          } else {
            ctx!.fillStyle = 'rgba(255,255,255,0.7)'; ctx!.beginPath(); ctx!.arc(d.x, d.y, d.len, 0, Math.PI*2); ctx!.fill();
          }
        }
      }
      requestAnimationFrame(frame);
    }
    resize(); spawn();
    if (weather !== 'clear') requestAnimationFrame(frame);
    window.addEventListener('resize', () => { resize(); spawn(); });
  })();

  // ===== 视差滚动 =====
  (() => {
    const sky = document.querySelector<HTMLElement>('.layer-sky');
    const mid = document.querySelector<HTMLElement>('.layer-mid');
    const front = document.querySelector<HTMLElement>('.layer-front');
    const title = document.querySelector<HTMLElement>('.hero-title');
    if (!sky || !mid || !front) return;

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        sky!.style.transform   = `translateY(${y * 0.15}px)`;
        mid!.style.transform   = `translateY(${y * 0.35}px)`;
        front!.style.transform = `translateY(${y * 0.6}px)`;
        if (title) {
          title.style.transform = `translate(-50%, ${y * 0.4}px)`;
          title.style.opacity = String(Math.max(0, 1 - y / 500));
        }
        ticking = false;
      });
    }
    window.addEventListener('scroll', onScroll, { passive: true });
  })();

  // ===== Section 转场动画 =====
  (() => {
    const sections = document.querySelectorAll('.section');
    sections.forEach(s => s.classList.add('section-transition'));
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) entry.target.classList.add('visible');
      });
    }, { threshold: 0.12 });
    sections.forEach(s => observer.observe(s));
  })();

  // ===== 键盘导航 =====
  (() => {
    const menuLinks = document.querySelectorAll<HTMLAnchorElement>('.rpg-menu a');
    if (menuLinks.length === 0) return;
    let selectedIdx = -1;

    function setSelected(idx: number) {
      menuLinks.forEach(l => l.classList.remove('selected'));
      if (idx >= 0 && idx < menuLinks.length) {
        menuLinks[idx].classList.add('selected');
        selectedIdx = idx;
        window.dispatchEvent(new CustomEvent('play-sfx', { detail: { type: 'hover' } }));
      }
    }

    document.addEventListener('keydown', (e) => {
      const hero = document.getElementById('home');
      if (!hero) return;
      if (hero.getBoundingClientRect().bottom < 0) return;

      if (e.key === 'ArrowRight') {
        e.preventDefault();
        setSelected((selectedIdx + 1) % menuLinks.length);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        setSelected(selectedIdx <= 0 ? menuLinks.length - 1 : selectedIdx - 1);
      } else if (e.key === 'Enter' && selectedIdx >= 0) {
        e.preventDefault();
        window.dispatchEvent(new CustomEvent('play-sfx', { detail: { type: 'navigate' } }));
        menuLinks[selectedIdx].click();
      }
    });
  })();
</script>
